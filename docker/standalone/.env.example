# Vessels All-in-One Configuration
# Copy to .env and add your API keys
#
# Quick Setup:
#   1. Copy this file to .env
#   2. Add at least one LLM API key
#   3. Run: docker compose up -d
#   4. Open: http://localhost:8080

# =============================================================================
# LLM API Keys (at least one required)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Graphiti Knowledge Graph Configuration
# =============================================================================
# Provider: openai or anthropic
GRAPHITI_LLM_PROVIDER=openai
# Model for knowledge graph operations (smaller/faster is better)
GRAPHITI_LLM_MODEL=gpt-4o-mini

# =============================================================================
# Hume AI Voice Integration (Optional)
# =============================================================================
# Get keys from: https://platform.hume.ai
# Enables voice personas for agents via EVI (Empathic Voice Interface)
HUME_API_KEY=
HUME_SECRET_KEY=

# =============================================================================
# Authentication (Optional)
# =============================================================================
# Set these to require login for the web UI
# AUTH_LOGIN=admin
# AUTH_PASSWORD=your-secure-password

# =============================================================================
# Advanced Configuration (usually not needed)
# =============================================================================
# Flask secret key (auto-generated if not set)
# FLASK_SECRET_KEY=your-random-secret-key
